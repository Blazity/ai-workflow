{
  "coreRoots": [
    "apps/worker/src",
    "apps/dashboard/app",
    "apps/dashboard/components",
    "apps/dashboard/lib",
    "packages"
  ],
  "coreRootsReason": "Core is the code that must stop knowing a provider. integrations/ is where the names belong. scripts/ is release and gate tooling, and the Arthur tenant repository it names is not the Arthur provider. changelog/ and docs/ are prose about what shipped. apps/*/drizzle holds applied migrations, which are history and cannot be rewritten.",
  "exclude": [
    "\\.(?:test|spec)\\.[cm]?[jt]sx?$",
    "\\.generated\\.[cm]?[jt]sx?$",
    "^apps/worker/src/test-support/",
    "^apps/worker/src/workflow-graph-suites/",
    "^apps/worker/src/mcp-dogfood/",
    "(?:^|/)fixtures/"
  ],
  "excludeReason": "A test cannot create production coupling: it exercises core code that still names a provider, and it changes with its subject when S8 to S12 move that provider out. Listing each of the several hundred of them would churn on every test edit and get this gate switched off. Generated files are the output of core files that are themselves scanned, so a name reported twice would be fixed once. The test-support, workflow-graph-suites, mcp-dogfood and fixtures trees are test material by another name.",
  "plannedIntegrations": {
    "arthur": {
      "stage": "S8",
      "reason": "the Arthur engine becomes integrations/arthur, and agent_tracing becomes a capability"
    },
    "slack": {
      "stage": "S9",
      "reason": "Slack becomes integrations/slack, and messaging becomes a capability core reaches through a port"
    },
    "gitlab": {
      "stage": "S10",
      "reason": "GitLab becomes integrations/gitlab, and the repository provider is validated against the registry rather than a CHECK constraint"
    },
    "github": {
      "stage": "S11",
      "reason": "GitHub becomes integrations/github"
    },
    "jira": {
      "stage": "S12",
      "reason": "Jira becomes integrations/jira, and the ticket lifecycle runs on the issue_tracker capability"
    }
  },
  "plannedIntegrationsReason": "A name core still writes, with the stage that takes it away. The gate watches these as well as the ids the registry holds, so it passes on what is here today and fails on anything new. When the stage lands, its id arrives from the registry, this entry and its allowlist rows go, and the gate says so if they do not.",
  "incidentalReason": "A row may carry \"incidental\": true when its files spell a provider id by accident, such as a CSS keyword or a URL, rather than depending on the provider; the gate then keeps the row listed but never reports it as stale, because such a hit comes and goes with ordinary edits and a failure on one could not be acted on.",
