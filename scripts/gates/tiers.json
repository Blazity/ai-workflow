{
  "workerSourceRoot": "apps/worker/src",
  "dashboardRoot": "apps/dashboard",
  "packageRoots": [
    "integrations/_fixtures",
    "integrations",
    "packages"
  ],
  "testFilePattern": "\\.(?:test|spec)\\.[cm]?[jt]sx?$",
  "stepDirective": {
    "tier": "engine",
    "directories": [],
    "value": "use step"
  },
  "classificationOrder": [
    "testing",
    "config",
    "app",
    "db",
    "infra",
    "services",
    "engine",
    "adapters"
  ],
  "tiers": {
    "testing": {
      "patterns": [
        "(?:^|/)(?:test-support|mcp-dogfood|workflow-graph-suites)(?:/|$)",
        "\\.(?:test|spec)\\.[cm]?[jt]sx?$"
      ]
    },
    "app": {
      "patterns": [
        "^apps/worker/src/(?:routes|middleware|plugins|mcp)(?:/|$)",
        "^apps/worker/src/(?:auth|auth-instance|nitro\\.d)\\.ts$",
        "^apps/dashboard(?:/|$)"
      ]
    },
    "services": {
      "patterns": [
        "^apps/worker/src/services(?:/|$)",
        "^apps/worker/src/(?:approvals|clarifications|manual-dispatch|schedule-trigger|webhook-trigger)(?:/|$)"
      ]
    },
    "engine": {
      "patterns": [
        "^apps/worker/src/(?:engine|harness-profiles|memory|post-pr-gate|pre-pr-checks|pre-sandbox|prompt-library|run-analysis|run-observability|sandbox|workflows)(?:/|$)"
      ]
    },
    "adapters": {
      "patterns": [
        "^apps/worker/src/adapters(?:/|$)"
      ]
    },
    "db": {
      "patterns": [
        "^apps/worker/src/db(?:/|$)",
        "^apps/worker/src/(?:schedule-trigger|webhook-trigger)/(?:[^/]+-schema|store)\\.[cm]?[jt]s$",
        "^apps/worker/src/(?:schedule-trigger|webhook-trigger)/.+/(?:[^/]+-schema|store)\\.[cm]?[jt]s$"
      ]
    },
    "config": {
      "patterns": [
        "^apps/worker/env\\.ts$",
        "^apps/worker/src/config(?:/|$)"
      ]
    },
    "infra": {
      "patterns": [
        "^apps/worker/src/infra(?:/|$)"
      ]
    }
  },
  "allowedEdges": {
    "app": [
      "services",
      "config"
    ],
    "services": [
      "engine",
      "adapters",
      "db",
      "infra"
    ],
    "engine": [
      "adapters",
      "db",
      "infra"
    ],
    "adapters": [
      "infra"
    ],
    "db": [
      "infra"
    ],
    "config": [],
    "infra": []
  },
  "edgeExceptions": {
    "app->engine": [
      "apps/worker/src/engine/index.ts"
    ]
  },
  "serviceClusterRoot": "apps/worker/src/services",
  "clusterDeepImports": "./cluster-deep-imports.json",
  "packageEdges": {
    "packages/*": [
      "packages/contracts"
    ],
    "packages/workflow-graph": [
      "packages/contracts",
      "packages/conditions"
    ],
    "packages/harness": [
      "packages/contracts",
      "packages/skills"
    ],
    "integrations/sdk": [
      "packages/contracts"
    ],
    "integrations/registry": [
      "integrations/*"
    ],
    "integrations/*": [
      "integrations/sdk"
    ]
  },
  "packageConsumers": [
    "app",
    "services",
    "engine",
    "adapters"
  ],
  "corePackageTargets": [
    "packages/*",
    "integrations/sdk",
    "integrations/registry"
  ],
  "restrictedPackageConsumers": {
    "db": [
      "packages/contracts"
    ]
  },
  "edgeReasons": [
    {
      "from": "integrations/registry",
      "reason": "the registry holds the integrations and the SDK and nothing else. It is generated by pnpm run gen:integrations, so an edge out of it is a generator change, not an edit: whatever it needs from core belongs in the hand-written entry that re-exports it, or in the caller."
    },
    {
      "from": "integrations/*",
      "reason": "an integration imports @integrations/sdk and its provider's own packages, and nothing else in this repository. What it needs from core reaches it through the context the SDK describes."
    },
    {
      "to": "integrations/*",
      "reason": "core may not import an integration. Ask the generated registry instead: @integrations/registry for the manifests (plain data, safe in a browser and in the Workflow DevKit flow bundle) and @integrations/registry/worker for the runtimes (server only). pnpm run gen:integrations writes both."
    }
  ],
  "forbiddenImports": [
    {
      "from": "^apps/dashboard/",
      "to": "^integrations/registry/(?:worker|runtimes\\.generated)\\.ts$",
      "reason": "the dashboard runs in a browser and the worker registry imports every integration's server code, provider SDKs and Node modules included. Read what the screen needs from @integrations/registry, which is manifest data."
    },
    {
      "from": "^integrations/registry/(?:index|manifests\\.generated)\\.ts$",
      "to": "(?:^|/)worker\\.ts$",
      "reason": "the registry's root entry is read in a browser and inside the Workflow DevKit flow bundle, where a Node module fails the Vercel build and nothing local. Worker entries belong in @integrations/registry/worker."
    }
  ]
}
