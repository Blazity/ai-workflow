{
  "workerSourceRoot": "apps/worker/src",
  "dashboardRoot": "apps/dashboard",
  "packageRoots": ["packages"],
  "packageTiers": [
    "contracts",
    "conditions",
    "prompts",
    "harness",
    "skills",
    "costs",
    "workflow-graph"
  ],
  "testFilePattern": "\\.(?:test|spec)\\.[cm]?[jt]sx?$",
  "stepDirective": {
    "tier": "engine",
    "directories": [
      "approvals",
      "clarifications",
      "dispatch-queue",
      "manual-dispatch",
      "repository-discovery",
      "schedule-trigger",
      "system-health",
      "webhook-trigger"
    ],
    "value": "use step"
  },
  "classificationOrder": [
    "testing",
    "config",
    "app",
    "db",
    "infra",
    "services",
    "engine",
    "adapters"
  ],
  "tiers": {
    "testing": {
      "patterns": [
        "(?:^|/)(?:test-support|mcp-dogfood)(?:/|$)",
        "\\.(?:test|spec)\\.[cm]?[jt]sx?$"
      ]
    },
    "app": {
      "patterns": [
        "^apps/worker/src/(?:routes|middleware|plugins|mcp)(?:/|$)",
        "^apps/worker/src/(?:auth|auth-instance|nitro\\.d)\\.ts$",
        "^apps/dashboard(?:/|$)"
      ]
    },
    "services": {
      "patterns": [
        "^apps/worker/src/(?:approvals|clarifications|dispatch-queue|manual-dispatch|repository-discovery|schedule-trigger|system-health|webhook-trigger)(?:/|$)",
        "^apps/worker/src/lib(?:/|$)",
        "^apps/worker/src/deployment-identity\\.ts$"
      ]
    },
    "engine": {
      "patterns": [
        "^apps/worker/src/(?:harness-profiles|memory|post-pr-gate|pre-pr-checks|pre-sandbox|prompt-library|run-analysis|run-observability|sandbox|workflow-definition|workflows)(?:/|$)"
      ]
    },
    "adapters": {
      "patterns": [
        "^apps/worker/src/adapters(?:/|$)"
      ]
    },
    "db": {
      "patterns": [
        "^apps/worker/src/db(?:/|$)",
        "^apps/worker/src/adapters/run-registry(?:/|$)",
        "^apps/worker/src/(?:approvals|clarifications|dispatch-queue|manual-dispatch|repository-discovery|schedule-trigger|system-health|webhook-trigger)/(?:[^/]+-schema|store)\\.[cm]?[jt]s$",
        "^apps/worker/src/(?:approvals|clarifications|dispatch-queue|manual-dispatch|repository-discovery|schedule-trigger|system-health|webhook-trigger)/.+/(?:[^/]+-schema|store)\\.[cm]?[jt]s$",
        "^apps/worker/src/(?:harness-profiles|prompt-library|workflow-definition)/store\\.[cm]?[jt]s$"
      ]
    },
    "config": {
      "patterns": [
        "^apps/worker/env\\.ts$",
        "^apps/worker/src/lib/env\\.(?:d\\.)?[cm]?[jt]sx?$",
        "^apps/worker/src/lib/env-[^/]+\\.(?:d\\.)?[cm]?[jt]sx?$"
      ]
    },
    "infra": {
      "patterns": [
        "^apps/worker/src/lib/(?:github-webhook-sig|llm|llm-provider|logger|telemetry|unique-violation|vcs-urls|webhook-crypto)\\.(?:d\\.)?[cm]?[jt]sx?$"
      ]
    }
  },
  "allowedEdges": {
    "app": ["services", "config"],
    "services": ["engine", "adapters", "db", "infra"],
    "engine": ["adapters", "db", "infra"],
    "adapters": ["infra"],
    "db": ["infra"],
    "config": [],
    "infra": []
  },
  "edgeExceptions": {
    "app->engine": ["apps/worker/src/workflows/agent.ts"]
  },
  "packageEdges": {
    "default": ["contracts"],
    "workflow-graph": ["conditions"],
    "harness": ["skills"]
  },
  "packageConsumers": ["app", "services", "engine", "adapters"],
  "restrictedPackageConsumers": {
    "db": ["contracts"]
  }
}
