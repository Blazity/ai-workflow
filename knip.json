{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.generated.ts",
    "apps/dashboard/.next/**",
    "apps/worker/.output/**",
    "apps/worker/src/mcp/contracts/mcp-contract.json",
    "apps/worker/src/sandbox/agents/fixtures/**",
    "apps/worker/workflow-test-fixtures/**"
  ],
  "entry": [
    "apps/worker/src/engine/blocks/*/manifest.ts",
    "apps/worker/src/engine/blocks/*/execute.ts"
  ],
  "ignoreIssues": {
    "apps/worker/src/engine/blocks/run-checks/execute.ts": ["exports"]
  }
}
