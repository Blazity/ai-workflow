{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.generated.ts",
    "apps/dashboard/.next/**",
    "apps/worker/.output/**",
    "apps/worker/src/mcp/contracts/mcp-contract.json",
    "apps/worker/src/sandbox/agents/fixtures/**",
    "apps/worker/workflow-test-fixtures/**"
  ],
  "ignoreDependencies": ["dependency-cruiser", "oxlint", "zod4"],
  "workspaces": {
    ".": {
      "entry": [
        "apps/worker/src/engine/blocks/*/manifest.ts",
        "apps/worker/src/engine/blocks/*/execute.ts",
        "docs/research/2026-09-09-import-graph.mjs"
      ]
    },
    "apps/dashboard": {
      "entry": ["**/*.test.ts", "**/*.test.tsx"]
    },
    "apps/worker": {
      "entry": ["src/services/*/index.ts"]
    },
    "packages/*": {
      "entry": ["index.ts", "*.test.ts"]
    }
  },
  "ignoreIssues": {
    "apps/worker/src/engine/blocks/run-checks/execute.ts": ["exports"],
    "apps/worker/src/engine/blocks/fetch-pr-context/execute.ts": ["exports"],
    "apps/worker/src/engine/steps/review-change-set.ts": ["exports"]
  }
}
