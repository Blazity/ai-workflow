{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; exec node \"$root/.codex/hooks/context-budget-guard.mjs\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; exec node \"$root/.codex/hooks/context-budget-guard.mjs\"'"
          }
        ]
      }
    ]
  }
}
