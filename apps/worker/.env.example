# Issue Tracker (Jira). The tracker is whichever issue_tracker integration is
# connected; these are the Jira integration's variables.
JIRA_BASE_URL=https://your-domain.atlassian.net
# Scoped service-account API token (Bearer). Issue from id.atlassian.com
# under the bot account; requests are routed through api.atlassian.com.
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# Board columns, feature switches, limits and the default model live in the Settings page and in harness profiles, not in the environment.

# Jira Webhook (strongly recommended — generate with `openssl rand -hex 32`).
# Without this, dispatch falls back to ~60s cron polling on every ticket.
JIRA_WEBHOOK_SECRET=

# VCS. A provider is in use when its integration is connected: set the
# variables of the one (or both) you use below, or connect it on the
# Integrations page.

# Commented review triggers require the selected provider's bot login so the bot
# cannot recursively trigger a run from its own review. Use GITHUB_BOT_LOGIN or
# GITLAB_BOT_LOGIN; VCS_BOT_LOGIN is a legacy fallback only when exactly one VCS
# provider is configured. For a GitHub App this is usually "<app-slug>[bot]".
# GITHUB_BOT_LOGIN=your-app-name[bot]
# GITLAB_BOT_LOGIN=your-gitlab-bot
# VCS_BOT_LOGIN=your-app-name[bot]

# --- GitHub ---
# GitHub App auth — see docs/GITHUB-APP-SETUP.md for the registration walkthrough.
# GITHUB_APP_PRIVATE_KEY is base64-encoded PEM (so it round-trips cleanly through
# Vercel's env UI): `base64 -i app.private-key.pem | tr -d '\n'`
GITHUB_APP_ID=1234567
GITHUB_APP_PRIVATE_KEY=base64-encoded-pem-contents
GITHUB_INSTALLATION_ID=98765432
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# --- GitLab (fill these in to connect it) ---
# Token requires `api` + `write_repository` scopes.
# GITLAB_TOKEN=glpat-xxxxxxxxxxxx
# GITLAB_PROJECT_ID=your-group/your-repo
# Generate with `openssl rand -hex 32`; must match the GitLab project webhook secret token.
# GITLAB_WEBHOOK_SECRET=
# GITLAB_HOST=https://gitlab.com       # advanced/self-managed override; GitLab.com is the documented path

# Repo allowlist. Comma-separated "owner/repo" paths the agent
# may ever branch/PR on (case-insensitive, exactly one slash per entry).
# Empty/unset = UNRESTRICTED: the agent may act on ANY installed repo (the
# multi-repo product default). When empty the worker logs a one-time warning; a
# malformed entry is logged at error level and ignored individually.
# AGENT_ALLOWED_REPOS=your-org/your-repo,your-org/another-repo

# Messaging (Chat SDK) — optional. When SLACK_TOKEN+CHANNEL_ID are unset, a no-op
# adapter is used and runs proceed silently.
CHAT_SDK_SLACK_TOKEN=xoxb-xxxxxxxxxxxx
CHAT_SDK_CHANNEL_ID=C0123456789

# Slack slash commands — required only if you register the /ai-workflow command.
# When unset, /webhooks/slack rejects all requests.
# SLACK_SIGNING_SECRET=
# SLACK_ALLOWED_USER_IDS=U0123,U4567   # comma-separated allowlist; empty = anyone

# Claude credentials (needed when a harness profile uses Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Codex credentials (needed when a harness profile uses Codex; one of API_KEY or OAUTH_TOKEN)
# CODEX_API_KEY=
# CODEX_CHATGPT_OAUTH_TOKEN=
# CODEX_PRICING_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# CODEX_PRICING_TTL_MS=3600000

# Optional commit-author override. Both must be set together.
# - GitHub: leave unset to author commits as the App's bot user (the GitHub UI
#   then renders them with the App's avatar and the `[bot]` badge).
# - GitLab: defaults to ai-workflow-blazity / ai-workflow@blazity.com.
# COMMIT_AUTHOR=
# COMMIT_EMAIL=

# Neon Postgres (run registry + post-PR gate store).
# On Vercel: install the Neon Postgres Marketplace integration with
# branch-per-environment enabled — DATABASE_URL is auto-injected by Vercel.
DATABASE_URL=

# Cron auth — required in production so polling and capability prewarm reject
# unauthenticated callers.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Better Auth (dashboard human login). The worker is the auth authority.
# BETTER_AUTH_SECRET: signing/encryption key, >= 32 chars. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL: the worker's own base URL (no trailing slash).
BETTER_AUTH_URL=https://your-worker.vercel.app
# DASHBOARD_ORIGIN: the dashboard's origin, for Better Auth trustedOrigins.
DASHBOARD_ORIGIN=https://your-dashboard.vercel.app
# DASHBOARD_TRUSTED_ORIGINS (optional): extra origins trusted for dashboard login
# on top of DASHBOARD_ORIGIN, e.g. a preview deployment's stable alias.
# Comma-separated; each entry must be a FULL origin URL (scheme included) or the
# worker fails env validation at startup. Unset = only DASHBOARD_ORIGIN is trusted.
# DASHBOARD_ORIGIN stays the one canonical origin used to build links and SSO redirects.
# DASHBOARD_TRUSTED_ORIGINS=https://your-dashboard-preview.vercel.app,https://alias.example.com
# The single predefined admin seeded at build time (no registration UI).
DASHBOARD_AUTH_EMAIL=
DASHBOARD_AUTH_PASSWORD=
# Fixed dashboard organization slug. Override only if you want a different
# slug before first auth bootstrap.
# DASHBOARD_ORG_SLUG=ai-workflow

# Dashboard SSO (optional). Leave all four unset for password-only login.
# If you set one, set the whole group.
# SSO_ISSUER=https://accounts.google.com
# SSO_ALLOWED_DOMAIN=example.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

# Resend email delivery (optional for password-only login; required before
# enabling invitation/password-reset email delivery). RESEND_API_KEY requires
# RESEND_FROM_EMAIL. RESEND_WEBHOOK_SECRET requires RESEND_API_KEY.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@example.com
# RESEND_WEBHOOK_SECRET=

# Arthur AI Engine (optional: tracing + prompt-injection check).
# Set both API_KEY and TRACE_ENDPOINT to install the tracer into every sandbox
# and enable the arthur_injection_check block.
# See https://www.arthur.ai/ for setup.
# GENAI_ENGINE_API_KEY=
# GENAI_ENGINE_TRACE_ENDPOINT=https://your-arthur-host/api/v1/traces

# Vercel Sandbox (LOCAL DEV ONLY — on Vercel, OIDC authenticates automatically)
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Workflow (LOCAL DEV ONLY — Vercel deployments use managed state)
# WORKFLOW_POSTGRES_URL=postgresql://localhost:5432/ai_workflow
