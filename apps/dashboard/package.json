{
  "name": "ai-workflow-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Blazity AI Workflow Cockpit — observability for Vercel Workflow runs, Arthur Engine evals & traces, and AI Gateway cost.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "tsx ../../scripts/gates/generate-block-catalog.ts --check && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test \"**/*.test.ts\" \"**/*.test.tsx\""
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@shared/conditions": "workspace:*",
    "@shared/contracts": "workspace:*",
    "@shared/harness": "workspace:*",
    "@shared/prompts": "workspace:*",
    "@shared/skills": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "postcss": "^8.5.23",
    "react-test-renderer": "19.2.4",
    "tailwindcss": "^4.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
