{
  "name": "ai-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter worker dev",
    "dev:dashboard": "pnpm --filter ai-workflow-dashboard dev",
    "dev:all": "pnpm --parallel -r run dev",
    "build": "pnpm -r build",
    "build:ci": "pnpm --filter worker build:ci && NEXT_TELEMETRY_DISABLED=1 pnpm --filter ai-workflow-dashboard build",
    "typecheck": "pnpm typecheck:release-notes && pnpm -r typecheck",
    "typecheck:release-notes": "tsc -p scripts/release-notes/tsconfig.json",
    "gen:blocks": "tsx scripts/gates/generate-block-catalog.ts",
    "test": "pnpm -r test",
    "test:workflow-sdk": "pnpm --filter worker test:workflow-sdk",
    "test:e2e": "pnpm --filter worker test:e2e",
    "test:e2e:agent": "pnpm --filter worker test:e2e:agent",
    "test:e2e:orchestration": "pnpm --filter worker test:e2e:orchestration",
    "test:e2e:capacity": "pnpm --filter worker test:e2e:capacity",
    "test:ci": "node --import tsx --test \"scripts/ci/*.test.ts\"",
    "test:packages": "pnpm -r --filter \"./packages/*\" run --if-present test",
    "verify:changed": "node --import tsx scripts/ci/verify-changed.ts",
    "test:e2e:harness-profiles": "pnpm --filter worker test:e2e:harness-profiles",
    "test:e2e:harness-profiles:dry": "pnpm --filter worker test:e2e:harness-profiles:dry",
    "test:e2e:replay": "pnpm --filter worker test:e2e:replay",
    "test:e2e:replay:dry": "pnpm --filter worker test:e2e:replay:dry",
    "test:release-notes": "node --import tsx --test \"scripts/release-notes/*.test.ts\"",
    "release-notes": "node --import tsx scripts/release-notes/cli.ts",
    "gate:boundaries": "node scripts/gates/boundaries.mjs",
    "gate:unused": "node scripts/gates/unused-code.mjs",
    "gate:lint": "node scripts/gates/lint.mjs",
    "gate:resurrected": "node scripts/gates/no-resurrected-paths.mjs",
    "gate:single-schema": "node scripts/gates/single-schema-version.mjs",
    "gate:package-contracts": "node scripts/gates/package-contracts.mjs",
    "gate:deps-consistency": "node scripts/gates/check-deps-consistency.mjs",
    "gate:docs-status": "if [ -f scripts/gates/docs-status.mjs ]; then node scripts/gates/docs-status.mjs; else echo '[gates] docs-status.mjs is not present yet, continuing'; fi",
    "gates": "pnpm run gate:boundaries && pnpm run gate:unused && pnpm run gate:lint && pnpm run gate:resurrected && pnpm run gate:single-schema && pnpm run gate:package-contracts && pnpm run gate:deps-consistency && pnpm run gate:docs-status",
    "gates:update-baselines": "pnpm run gate:boundaries -- --update-baseline && pnpm run gate:unused -- --update-baseline && pnpm run gate:lint -- --update-baseline"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "18.2.0",
    "knip": "6.35.1",
    "oxlint": "1.82.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@workflow/core@4.8>nanoid": "5.1.16",
      "next@15.5>postcss": "8.5.28",
      "qs@>=6.11.1 <6.16.0": "6.16.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
