{
  "name": "ai-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter worker dev",
    "dev:dashboard": "pnpm --filter ai-workflow-dashboard dev",
    "dev:all": "pnpm --parallel -r run dev",
    "build": "pnpm -r build",
    "build:ci": "pnpm --filter worker build:ci && NEXT_TELEMETRY_DISABLED=1 pnpm --filter ai-workflow-dashboard build",
    "typecheck": "pnpm typecheck:release-notes && pnpm -r typecheck",
    "typecheck:release-notes": "tsc -p scripts/release-notes/tsconfig.json",
    "test": "pnpm -r test",
    "test:workflow-sdk": "pnpm --filter worker test:workflow-sdk",
    "test:e2e": "pnpm --filter worker test:e2e",
    "test:e2e:agent": "pnpm --filter worker test:e2e:agent",
    "test:e2e:orchestration": "pnpm --filter worker test:e2e:orchestration",
    "test:e2e:capacity": "pnpm --filter worker test:e2e:capacity",
    "test:ci": "node --import tsx --test \"scripts/ci/*.test.ts\"",
    "test:e2e:harness-profiles": "pnpm --filter worker test:e2e:harness-profiles",
    "test:e2e:harness-profiles:dry": "pnpm --filter worker test:e2e:harness-profiles:dry",
    "test:e2e:replay": "pnpm --filter worker test:e2e:replay",
    "test:e2e:replay:dry": "pnpm --filter worker test:e2e:replay:dry",
    "test:release-notes": "node --import tsx --test \"scripts/release-notes/*.test.ts\"",
    "release-notes": "node --import tsx scripts/release-notes/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@workflow/core@4.8>nanoid": "5.1.16",
      "next@15.5>postcss": "8.5.28",
      "qs@>=6.11.1 <6.16.0": "6.16.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
