{
  "name": "@integrations/slack",
  "description": "Slack: run notifications in a channel thread, the /ai-workflow slash command, and message search for a research block.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./manifest.ts",
  "types": "./manifest.ts",
  "exports": {
    ".": {
      "types": "./manifest.ts",
      "default": "./manifest.ts"
    },
    "./manifest": {
      "types": "./manifest.ts",
      "default": "./manifest.ts"
    },
    "./worker": {
      "types": "./worker.ts",
      "default": "./worker.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"*.test.ts\"",
    "test:zod4": "node --import tsx --import ../../packages/zod4-alias.mjs --test \"*.test.ts\""
  },
  "dependencies": {
    "@integrations/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod4": "catalog:"
  }
}
