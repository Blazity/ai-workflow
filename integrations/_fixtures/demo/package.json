{
  "name": "@integrations/demo",
  "description": "The test and demo integration, present in the registries only behind the fixture flag.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./manifest.ts",
  "types": "./manifest.ts",
  "exports": {
    ".": { "types": "./manifest.ts", "default": "./manifest.ts" },
    "./manifest": { "types": "./manifest.ts", "default": "./manifest.ts" },
    "./worker": { "types": "./worker.ts", "default": "./worker.ts" },
    "./dashboard": { "types": "./dashboard.tsx", "default": "./dashboard.tsx" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@integrations/host-ui": "workspace:*",
    "@integrations/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
