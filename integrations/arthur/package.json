{
  "name": "@integrations/arthur",
  "description": "Arthur Engine: agent traces, continuous evaluation and a prompt-injection screen.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./manifest.ts",
  "types": "./manifest.ts",
  "exports": {
    ".": {
      "types": "./manifest.ts",
      "default": "./manifest.ts"
    },
    "./manifest": {
      "types": "./manifest.ts",
      "default": "./manifest.ts"
    },
    "./worker": {
      "types": "./worker.ts",
      "default": "./worker.ts"
    },
    "./dashboard": {
      "types": "./dashboard.tsx",
      "default": "./dashboard.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:tracer": "node build-tracer.mjs",
    "test": "node --import tsx --test \"*.test.ts\" \"*.test.tsx\"",
    "test:zod4": "node --import tsx --import ../../packages/zod4-alias.mjs --test \"*.test.ts\" \"*.test.tsx\""
  },
  "dependencies": {
    "@integrations/host-ui": "workspace:*",
    "@integrations/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-test-renderer": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod4": "catalog:"
  }
}
