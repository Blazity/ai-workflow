{
  "name": "@integrations/bitbucket",
  "description": "Bitbucket Cloud version control, workspace repository discovery and repository webhooks.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./manifest.ts",
  "types": "./manifest.ts",
  "exports": {
    ".": {
      "types": "./manifest.ts",
      "default": "./manifest.ts"
    },
    "./manifest": {
      "types": "./manifest.ts",
      "default": "./manifest.ts"
    },
    "./worker": {
      "types": "./worker.ts",
      "default": "./worker.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"!(node_modules)/**/*.test.{ts,tsx}\" \"*.test.{ts,tsx}\"",
    "test:zod4": "node --import tsx --import ../../packages/zod4-alias.mjs --test \"!(node_modules)/**/*.test.{ts,tsx}\" \"*.test.{ts,tsx}\""
  },
  "dependencies": {
    "@integrations/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod4": "catalog:"
  }
}
