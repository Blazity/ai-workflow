{
  "name": "@integrations/github",
  "description": "GitHub version control, repository discovery, skill sources and App webhooks.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./manifest.ts",
  "types": "./manifest.ts",
  "exports": {
    ".": { "types": "./manifest.ts", "default": "./manifest.ts" },
    "./manifest": { "types": "./manifest.ts", "default": "./manifest.ts" },
    "./worker": { "types": "./worker.ts", "default": "./worker.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:zod4": "NODE_OPTIONS='--import=../../packages/zod4-alias.mjs' vitest run"
  },
  "dependencies": {
    "@integrations/sdk": "workspace:*",
    "@octokit/auth-app": "catalog:",
    "@octokit/rest": "catalog:",
    "tar-stream": "^3.1.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/tar-stream": "^3.1.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod4": "catalog:"
  }
}
