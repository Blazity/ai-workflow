{
  "name": "@integrations/gitlab",
  "description": "GitLab version control, repository discovery and project webhooks.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./manifest.ts",
  "types": "./manifest.ts",
  "exports": {
    ".": { "types": "./manifest.ts", "default": "./manifest.ts" },
    "./manifest": { "types": "./manifest.ts", "default": "./manifest.ts" },
    "./worker": { "types": "./worker.ts", "default": "./worker.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:zod4": "NODE_OPTIONS='--import=../../packages/zod4-alias.mjs' vitest run"
  },
  "dependencies": {
    "@gitbeaker/requester-utils": "^43.8.0",
    "@gitbeaker/rest": "^43.8.0",
    "@integrations/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod4": "catalog:"
  }
}
